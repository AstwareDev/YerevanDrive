{
  "name": "yerevan-drift-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node tools/fetch-data.mjs",
    "build:map": "node tools/build-map.mjs",
    "dev": "vite",
    "build": "vite build",
    "imagery": "node tools/fetch-imagery.mjs && node tools/fetch-imagery.mjs 19 500 public/map/aerial_hi.webp",
    "build:landmarks": "node tools/build-landmarks.mjs",
    "build:props": "node tools/build-props.mjs",
    "data:far": "node tools/fetch-far.mjs",
    "build:tiles": "node tools/build-tiles.mjs && node tools/pack-tiles.mjs",
    "build:lowres": "node tools/make-lowres.mjs",
    "clean:road": "node tools/clean-onroad.mjs",
    "pack:tiles": "node tools/pack-tiles.mjs",
    "build:all": "node tools/build-orbeli.mjs && node tools/build-landmarks.mjs && node tools/build-map.mjs && node tools/build-tiles.mjs && node tools/build-props.mjs && node tools/clean-onroad.mjs && node tools/build-car.mjs && node tools/build-nav.mjs",
    "build:textures": "node tools/build-textures.mjs",
    "build:car": "node tools/build-car.mjs",
    "build:heli": "node tools/build-heli.mjs",
    "build:garage": "node tools/build-garage.mjs",
    "sim:heli": "node tools/sim-heli.mjs",
    "sim:car": "node tools/sim-car.mjs",
    "build:nav": "node tools/build-nav.mjs",
    "test:nav": "node tools/test-nav.mjs",
    "docs:diagrams": "node tools/diagrams/build.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "clipper-lib": "^6.4.2",
    "earcut": "^3.2.4",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "trystero": "^0.27.0"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
